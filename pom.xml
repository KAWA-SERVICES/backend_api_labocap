<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.labo</groupId>
    <artifactId>labo-anapath-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>labo-anapath-api</name>
    <description>API REST de gestion de laboratoire d'anatomopathologie</description>

    <properties>
        <java.version>21</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.48</lombok.version>
        <jjwt.version>0.13.0</jjwt.version>
        <springdoc.version>3.1.1</springdoc.version>
        <!-- 1.19 parle l'API Docker 1.32, refusée par Docker 29 (minimum 1.44) : sans ce
             saut, aucun test Testcontainers ne démarre sur un démon récent. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Rechargement à chaud en dev : surveille target/classes et redémarre
             l'app automatiquement quand les classes changent (mvn compile). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Signalisation des appels. Le fil se rafraîchit par sondage toutes
             les cinq secondes : très suffisant pour du texte, inutilisable pour
             établir un appel, qui mettrait dix secondes à démarrer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Stockage des fichiers sur S3. Le contenu y arrive déjà chiffré par
             le serveur : AWS ne voit jamais une lame en clair. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.31.16</version>
            <exclusions>
                <!-- Le client asynchrone n'est pas utilisé : tous les appels au
                     dépôt sont synchrones, dans le fil de la requête. -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <!-- Boot 4 : les métriques Micrometer (dont /actuator/prometheus, lot 10)
                 ne font plus partie du starter actuator. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-micrometer-metrics</artifactId>
        </dependency>
        <!-- Métriques au format Prometheus (/actuator/prometheus). Version
             gérée par Spring Boot. L'exposition reste éteinte par défaut :
             voir management.endpoint.prometheus.enabled dans application.yml. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <!-- Boot 4 : sans ce starter, Flyway est sur le classpath mais rien ne
                 le lance ; les migrations ne jouaient plus et Hibernate refusait de
                 démarrer (table journal_acces absente, déploiement du 03/10). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-gson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Google Authenticator TOTP -->

        <!-- ZXing QR Code generation -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.4</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.4</version>
        </dependency>

        <!-- SpringDoc OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Thymeleaf (PDF template rendering) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- OpenHTMLToPDF (HTML → PDF) -->
        <!-- Notifications hors-app. Le SDK officiel plutôt qu'un appel HTTP
             écrit à la main : l'API v1 de FCM exige un jeton OAuth2 signé par
             le compte de service et renouvelé, ce que ce SDK fait seul. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.11.0</version>
        </dependency>

        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.1.87</version>
        </dependency>
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-svg-support</artifactId>
            <version>1.1.87</version>
        </dependency>
        <!-- Jsoup : normalise le HTML (contenu éditeur, balises non fermées,
             entités &nbsp;) en XHTML bien formé exigé par OpenHTMLToPDF -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
        </dependency>

        <!-- Mail -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Rate limiting -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <!-- Boot 4 : RestTemplateCustomizer et le support RestTemplate ont leur module. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>
        <dependency>
            <!-- Boot 4 : TestRestTemplate, @LocalServerPort, @WebMvcTest, @DataJpaTest et
                 @AutoConfigureTestDatabase ne sont plus dans le starter de test. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Boot 4 : @AutoConfigureMetrics (ex-@AutoConfigureObservability) a son module. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-metrics-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Boot 4 : la sécurité des tranches de test (@WebMvcTest, MockMvc) a son module. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- firebase-admin 9.11 en a besoin à l'exécution (transport asynchrone
                 des notifications). Le déclarer en portée test, comme c'était le
                 cas pour que TestRestTemplate sache émettre PATCH, l'écartait du
                 jar livré : l'API refusait de démarrer en production
                 (NoClassDefFoundError AsyncClientConnectionManager, 03/10). -->
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!-- Dépendances connues vulnérables (lot 4). Hors cycle par défaut :
                     la base NVD pèse et se télécharge lentement sans clé. La CI
                     lance `mvn dependency-check:check` avec NVD_API_KEY ; le
                     build échoue au-delà de CVSS 7, sauf suppression justifiée
                     dans dependency-check-suppressions.xml. -->
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <suppressionFiles>
                        <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <formats><format>HTML</format><format>JSON</format></formats>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Les quatre variables d'application.yml sans valeur par défaut :
                         sans elles aucun contexte Spring ne démarre et les 45 classes
                         d'intégration tombent d'un bloc. Valeurs de test, aucun lien
                         avec la production. -->
                    <environmentVariables>
                        <!-- db/migration ne se rejoue pas sur une base vide (V10 suppose des
                             tables venues du dump Laravel) et la baseline de db/local se
                             périme à chaque entité ajoutée (il lui manquait `antibiotics`
                             au 2026-10-02, et `roles.is_protected` à son seed). Les tests
                             Testcontainers laissent donc Hibernate créer le schéma depuis
                             les entités ; seule l'extension unaccent, que les requêtes
                             appellent, vient de db/local. Les données, chaque test les crée. -->
                        <SPRING_FLYWAY_ENABLED>false</SPRING_FLYWAY_ENABLED>
                        <SPRING_JPA_HIBERNATE_DDL_AUTO>create</SPRING_JPA_HIBERNATE_DDL_AUTO>
                        <SPRING_SQL_INIT_MODE>always</SPRING_SQL_INIT_MODE>
                        <SPRING_SQL_INIT_SCHEMA_LOCATIONS>classpath:schema-test.sql</SPRING_SQL_INIT_SCHEMA_LOCATIONS>
                        <SPRING_SQL_INIT_DATA_LOCATIONS>classpath:seed-test.sql</SPRING_SQL_INIT_DATA_LOCATIONS>
                        <SPRING_JPA_DEFER_DATASOURCE_INITIALIZATION>true</SPRING_JPA_DEFER_DATASOURCE_INITIALIZATION>
                        <JWT_SECRET>cle-de-test-uniquement-0123456789abcdef0123456789abcdef0123456789</JWT_SECRET>
                        <MAIL_HOST>localhost</MAIL_HOST>
                        <MAIL_PORT>2525</MAIL_PORT>
                        <MAIL_FROM>test@labo.local</MAIL_FROM>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <!-- Chaque classe d'intégration a son propre PostgreSQL, donc son
                             propre contexte : les garder en cache (32 par défaut) ne sert à
                             rien et fait déborder la mémoire au 40e. -->
                        <spring.test.context.cache.maxSize>1</spring.test.context.cache.maxSize>
                    </systemPropertyVariables>
                    <!-- Surefire ne lance par défaut que *Test.java : les 29 classes
                         *IT.java (Testcontainers) ne tournaient jamais avec
                         `mvn verify`, seulement depuis l'IDE. -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
